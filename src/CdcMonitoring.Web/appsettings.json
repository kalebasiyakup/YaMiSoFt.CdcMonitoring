{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MetadataDb": ""
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Quartz": {
    "UseClusteredPostgresStore": false
  },
  "Kafka": {
    "BootstrapServersEnvironmentVariable": "KAFKA_BOOTSTRAP_SERVERS",
    "UsernameEnvironmentVariable": "KAFKA_USERNAME",
    "PasswordEnvironmentVariable": "KAFKA_SASL_PASSWORD",
    "RequestTimeoutSeconds": 20
  }
}
