@page "/settings"
@rendermode InteractiveServer
@inherits TimeZoneAwareComponentBase
@inject SystemSettingsService SettingsService

<PageTitle>Ayarlar</PageTitle>

<h1>Ayarlar</h1>

<p><em>Bu sayfadaki tüm değişiklikler yeniden başlatma gerekmeden en geç ~15 sn içinde devreye girer (zamanlama ayarları bir sonraki job yoklamasında uygulanır).</em></p>

@if (_model is null)
{
    <p><em>Yükleniyor...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="settings">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <ul class="nav nav-tabs settings-tabs mb-4">
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "healthcheck" ? "active" : "")" @onclick='() => _activeTab = "healthcheck"'>Bağlantı Health Check</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "discovery" ? "active" : "")" @onclick='() => _activeTab = "discovery"'>CDC Keşfi</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "alerts" ? "active" : "")" @onclick='() => _activeTab = "alerts"'>Alarm Eşikleri</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "reconciliation" ? "active" : "")" @onclick='() => _activeTab = "reconciliation"'>Veri Tutarlılık Kontrolü</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(_activeTab == "email" ? "active" : "")" @onclick='() => _activeTab = "email"'>E-posta (SMTP)</button>
            </li>
        </ul>

        @if (_activeTab == "healthcheck")
        {
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Aralık (sn) <InfoTooltip Text="Her bağlantının canlılık kontrolünün (TCP/Postgres bağlanabilirlik testi) kaç saniyede bir çalışacağı." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.HealthCheckIntervalSeconds" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Paralellik <InfoTooltip Text="Bir tarama turunda aynı anda kaç bağlantının health check'inin çalıştırılacağı (eşzamanlılık derecesi)." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.HealthCheckMaxDegreeOfParallelism" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Zaman Aşımı (sn) <InfoTooltip Text="Tek bir bağlantı için health check probu bu süre içinde yanıt vermezse başarısız sayılır." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.HealthCheckTimeoutSeconds" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Kayıt Saklama Süresi (gün) <InfoTooltip Text="Bu süreden eski health check kayıtları düzenli olarak silinir (audit log bundan etkilenmez, kalıcı tutulur)." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.HealthCheckRetentionDays" />
                </div>
            </div>
        }

        @if (_activeTab == "discovery")
        {
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Aralık (sn) <InfoTooltip Text="pg_publication/pg_subscription/pg_replication_slots taramasının (yeni CDC ilişkisi keşfi) kaç saniyede bir çalışacağı." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.DiscoveryIntervalSeconds" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Paralellik <InfoTooltip Text="Bir tarama turunda aynı anda kaç bağlantının keşif sorgularının çalıştırılacağı (eşzamanlılık derecesi)." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.DiscoveryMaxDegreeOfParallelism" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Zaman Aşımı (sn) <InfoTooltip Text="Tek bir bağlantı için keşif sorgusu bu süre içinde tamamlanmazsa iptal edilir." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.DiscoveryTimeoutSeconds" />
                </div>
            </div>
        }

        @if (_activeTab == "alerts")
        {
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Değerlendirme Aralığı (sn) <InfoTooltip Text="Aşağıdaki tüm alarm kurallarının (slot, WAL, subscription, lag, health check) kaç saniyede bir değerlendirileceği." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.AlertingIntervalSeconds" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Slot İnaktif Eşiği (dk) <InfoTooltip Text="Bir replication slot bu süre boyunca kesintisiz inaktif kalırsa Kritik seviyede 'Slot İnaktif' alarmı tetiklenir." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.SlotInactiveMinutes" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lag Süreklilik Eşiği (dk) <InfoTooltip Text="Lag, byte eşiğinin üstünde bu süre boyunca kesintisiz kalırsa Uyarı seviyesinde 'Lag' alarmı tetiklenir." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.LagWarningSustainedMinutes" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lag Eşiği (byte) <InfoTooltip Text="Replication lag'in bu değeri aşması ve süreklilik eşiğini de doldurması durumunda uyarı alarmı tetiklenir." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.LagWarningBytes" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Ardışık Health Check Hata Sayısı <InfoTooltip Text="Bir bağlantı üst üste bu kadar health check'te başarısız olursa 'Health Check Başarısız' uyarısı tetiklenir." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.ConsecutiveHealthCheckFailures" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Sağlıklı WAL Durumları (virgülle ayrılmış) <InfoTooltip Text="Bu listede olmayan herhangi bir WAL durumu, Kritik seviyede 'WAL Kritik' alarmını tetikler." /></label>
                    <InputText class="form-control" @bind-Value="_model.HealthyWalStatuses" placeholder="reserved,extended" />
                </div>
            </div>
        }

        @if (_activeTab == "reconciliation")
        {
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="form-label">Çalışma Sıklığı <InfoTooltip Text="Onaylanmış/manuel CDC ilişkileri için kaynak-hedef satır sayısı/checksum karşılaştırmasının ne sıklıkla çalışacağı." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.ReconciliationIntervalValue" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <InputSelect class="form-select" @bind-Value="_model.ReconciliationIntervalUnit">
                        <option value="@ReconciliationIntervalUnit.Minutes">Dakika</option>
                        <option value="@ReconciliationIntervalUnit.Hours">Saat</option>
                        <option value="@ReconciliationIntervalUnit.Days">Gün</option>
                    </InputSelect>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Kayıt Saklama Süresi (gün) <InfoTooltip Text="Bu süreden eski veri tutarlılık kontrolü sonuçları düzenli olarak silinir (audit log bundan etkilenmez, kalıcı tutulur)." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.ReconciliationRetentionDays" />
                </div>
            </div>
        }

        @if (_activeTab == "email")
        {
            <div class="mb-3 form-check">
                <InputCheckbox class="form-check-input" @bind-Value="_model.EmailEnabled" id="emailEnabled" />
                <label class="form-check-label" for="emailEnabled">E-posta bildirimleri aktif</label>
                <InfoTooltip Text="Kapalıyken alarm koşulları hâlâ değerlendirilir ve kaydedilir, ancak hiçbir e-posta gönderilmez." />
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">SMTP Sunucu <InfoTooltip Text="Bildirim e-postalarının gönderileceği SMTP sunucusunun host adı veya IP'si (ör. smtp.sirketiniz.com veya mailpit gibi local test sunucusu)." /></label>
                    <InputText class="form-control" @bind-Value="_model.SmtpHost" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Port <InfoTooltip Text="SMTP sunucusunun port numarası (yaygın: 587 StartTLS, 465 SMTPS, 25 düz metin/test)." /></label>
                    <InputNumber class="form-control" @bind-Value="_model.SmtpPort" />
                </div>
                <div class="col-md-3 form-check mt-4">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.SmtpUseStartTls" id="startTls" />
                    <label class="form-check-label" for="startTls">StartTLS kullan</label>
                    <InfoTooltip Text="Bağlantı düz metin başlayıp sonradan TLS'e yükseltilir. Sunucunuz doğrudan TLS (SMTPS, genelde 465) istiyorsa bunu kapatın." />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">SMTP Kullanıcı Adı <InfoTooltip Text="SMTP sunucusunda kimlik doğrulama için kullanılacak kullanıcı adı; sunucu anonim gönderime izin veriyorsa boş bırakılabilir." /></label>
                    <InputText class="form-control" @bind-Value="_model.SmtpUsername" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">
                        Yeni SMTP Parolası
                        <InfoTooltip Text="Girilirse mevcut şifreli parolanın yerini alır; boş bırakılırsa var olan parola (varsa) korunur. Parola hiçbir ekranda düz metin gösterilmez." />
                        @if (_model.HasSmtpPassword)
                        {
                            <span class="text-muted">(parola ayarlı — boş bırakılırsa korunur)</span>
                        }
                    </label>
                    <InputText type="password" class="form-control" @bind-Value="_model.NewSmtpPassword" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Gönderen Adres <InfoTooltip Text="Bildirim e-postalarının 'Kimden' (From) alanında görünecek e-posta adresi." /></label>
                    <InputText class="form-control" @bind-Value="_model.FromAddress" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Gönderen Görünen Ad <InfoTooltip Text="Alıcının gelen kutusunda e-posta adresinin yanında görünecek görünen ad (ör. 'CDC Monitoring')." /></label>
                    <InputText class="form-control" @bind-Value="_model.FromDisplayName" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Alıcılar (virgülle ayrılmış e-posta listesi) <InfoTooltip Text="Tüm alarm bildirimlerinin gönderileceği e-posta adresleri; birden fazla adres virgülle ayrılır." /></label>
                <InputText class="form-control" @bind-Value="_model.Recipients" placeholder="oncall@yourcompany.com,ops@yourcompany.com" />
            </div>
        }

        <button type="submit" class="btn btn-primary mt-2">Kaydet</button>

        @if (_activeTab == "email")
        {
            <button type="button" class="btn btn-outline-secondary mt-2 ms-2" disabled="@_isTestingEmail" @onclick="TestEmailAsync">
                @(_isTestingEmail ? "Gönderiliyor..." : "E-postayı Test Et")
            </button>
        }

        @if (_savedAt is not null)
        {
            <span class="text-success ms-3">Kaydedildi (@FormatLocal(_savedAt.Value, "T")).</span>
        }
    </EditForm>

    @if (_emailTestResult is { Success: true })
    {
        <div class="alert alert-success mt-3">Test e-postası gönderildi — alıcıların gelen kutusunu (ve spam klasörünü) kontrol edin.</div>
    }
    else if (_emailTestResult is { Success: false })
    {
        <div class="alert alert-danger mt-3">Test e-postası gönderilemedi: @_emailTestResult.ErrorMessage</div>
    }
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger mt-3">@_errorMessage</div>
}

@code {
    private SettingsFormModel? _model;
    private string? _errorMessage;
    private DateTimeOffset? _savedAt;
    private string _activeTab = "healthcheck";
    private bool _isTestingEmail;
    private EmailTestResult? _emailTestResult;

    protected override async Task OnInitializedAsync()
    {
        var dto = await SettingsService.GetAsync();
        _model = ToFormModel(dto);
    }

    private async Task SubmitAsync()
    {
        if (_model is null) return;
        _errorMessage = null;
        _savedAt = null;

        try
        {
            var request = new UpdateSystemSettingsRequest(
                _model.HealthCheckIntervalSeconds,
                _model.HealthCheckMaxDegreeOfParallelism,
                _model.HealthCheckTimeoutSeconds,
                _model.HealthCheckRetentionDays,
                _model.DiscoveryIntervalSeconds,
                _model.DiscoveryMaxDegreeOfParallelism,
                _model.DiscoveryTimeoutSeconds,
                _model.AlertingIntervalSeconds,
                _model.SlotInactiveMinutes,
                _model.LagWarningSustainedMinutes,
                _model.LagWarningBytes,
                _model.ConsecutiveHealthCheckFailures,
                SplitCsv(_model.HealthyWalStatuses),
                ToSeconds(_model.ReconciliationIntervalValue, _model.ReconciliationIntervalUnit),
                _model.ReconciliationRetentionDays,
                _model.EmailEnabled,
                _model.SmtpHost,
                _model.SmtpPort,
                _model.SmtpUseStartTls,
                _model.SmtpUsername,
                _model.NewSmtpPassword,
                _model.FromAddress,
                _model.FromDisplayName,
                SplitCsv(_model.Recipients));

            var dto = await SettingsService.UpdateAsync(request);
            _model = ToFormModel(dto);
            _savedAt = DateTimeOffset.UtcNow;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task TestEmailAsync()
    {
        if (_model is null) return;
        _emailTestResult = null;
        _errorMessage = null;
        _isTestingEmail = true;

        try
        {
            _emailTestResult = await SettingsService.TestEmailAsync(new TestEmailRequest(
                _model.SmtpHost,
                _model.SmtpPort,
                _model.SmtpUseStartTls,
                _model.SmtpUsername,
                _model.NewSmtpPassword,
                _model.FromAddress,
                _model.FromDisplayName,
                SplitCsv(_model.Recipients)));
        }
        catch (Exception ex)
        {
            _emailTestResult = new EmailTestResult(false, ex.Message);
        }
        finally
        {
            _isTestingEmail = false;
        }
    }

    private static SettingsFormModel ToFormModel(SystemSettingsDto dto) => new()
    {
        HealthCheckIntervalSeconds = dto.HealthCheckIntervalSeconds,
        HealthCheckMaxDegreeOfParallelism = dto.HealthCheckMaxDegreeOfParallelism,
        HealthCheckTimeoutSeconds = dto.HealthCheckTimeoutSeconds,
        HealthCheckRetentionDays = dto.HealthCheckRetentionDays,
        DiscoveryIntervalSeconds = dto.DiscoveryIntervalSeconds,
        DiscoveryMaxDegreeOfParallelism = dto.DiscoveryMaxDegreeOfParallelism,
        DiscoveryTimeoutSeconds = dto.DiscoveryTimeoutSeconds,
        AlertingIntervalSeconds = dto.AlertingIntervalSeconds,
        SlotInactiveMinutes = dto.SlotInactiveMinutes,
        LagWarningSustainedMinutes = dto.LagWarningSustainedMinutes,
        LagWarningBytes = dto.LagWarningBytes,
        ConsecutiveHealthCheckFailures = dto.ConsecutiveHealthCheckFailures,
        HealthyWalStatuses = string.Join(",", dto.HealthyWalStatuses),
        ReconciliationIntervalValue = FromSeconds(dto.ReconciliationIntervalSeconds, out var reconciliationUnit),
        ReconciliationIntervalUnit = reconciliationUnit,
        ReconciliationRetentionDays = dto.ReconciliationRetentionDays,
        EmailEnabled = dto.EmailEnabled,
        SmtpHost = dto.SmtpHost,
        SmtpPort = dto.SmtpPort,
        SmtpUseStartTls = dto.SmtpUseStartTls,
        SmtpUsername = dto.SmtpUsername,
        HasSmtpPassword = dto.HasSmtpPassword,
        FromAddress = dto.FromAddress,
        FromDisplayName = dto.FromDisplayName,
        Recipients = string.Join(",", dto.Recipients)
    };

    private static List<string> SplitCsv(string csv) =>
        csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private static int ToSeconds(int value, ReconciliationIntervalUnit unit) => unit switch
    {
        ReconciliationIntervalUnit.Minutes => value * 60,
        ReconciliationIntervalUnit.Hours => value * 3600,
        _ => value * 86400
    };

    // Saniyeyi, tam bölünen en büyük birime (gün > saat > dakika) çevirip geri gösterir —
    // böylece kullanıcı "2 saat" girip kaydettiğinde tekrar açtığında "7200 saniye" ya da
    // tuhaf bir gün kesri değil, yine "2 saat" görür.
    private static int FromSeconds(int totalSeconds, out ReconciliationIntervalUnit unit)
    {
        if (totalSeconds % 86400 == 0)
        {
            unit = ReconciliationIntervalUnit.Days;
            return totalSeconds / 86400;
        }

        if (totalSeconds % 3600 == 0)
        {
            unit = ReconciliationIntervalUnit.Hours;
            return totalSeconds / 3600;
        }

        unit = ReconciliationIntervalUnit.Minutes;
        return Math.Max(1, totalSeconds / 60);
    }
}
