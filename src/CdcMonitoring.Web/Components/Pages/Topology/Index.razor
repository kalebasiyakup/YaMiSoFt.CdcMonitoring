@page "/topology"
@rendermode InteractiveServer
@using CdcMonitoring.Domain.Enums
@implements IAsyncDisposable
@inject CdcRelationshipManagementService Management
@inject ConnectionRegistryService Registry
@inject IJSRuntime JS

<PageTitle>CDC Topoloji</PageTitle>

<h1>CDC Topoloji</h1>

<p>
    <span class="badge bg-success">Sağlıklı</span>
    <span class="badge bg-warning text-dark">Uyarı</span>
    <span class="badge bg-danger">Kritik</span>
    <span class="badge bg-secondary">Disabled / bilinmiyor</span>
    — her @_refreshIntervalSeconds sn'de bir otomatik güncellenir.
</p>

<div id="topology-canvas" style="width: 100%; height: 640px; border: 1px solid #dee2e6; border-radius: 4px;"></div>

@if (_relationshipCount == 0)
{
    <p class="text-muted mt-3"><em>Henüz görüntülenecek CDC ilişkisi yok.</em></p>
}

@code {
    private IJSObjectReference? _module;
    private PeriodicTimer? _timer;
    private Task? _refreshLoopTask;
    private readonly int _refreshIntervalSeconds = 15;
    private int _relationshipCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/topology.js");
        await RefreshAsync();
        StateHasChanged();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));
        _refreshLoopTask = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync())
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException)
        {
            // Sayfa kapatıldığında timer dispose edilir; sessizce çık.
        }
    }

    private async Task RefreshAsync()
    {
        var connections = await Registry.ListAsync();
        var relationships = await Management.ListAsync();
        _relationshipCount = relationships.Count;

        var relevantConnectionIds = relationships
            .SelectMany(r => new[] { r.SourceConnectionId, r.TargetConnectionId })
            .ToHashSet();

        var nodes = connections
            .Where(c => relevantConnectionIds.Contains(c.Id))
            .Select(c => new
            {
                id = c.Id,
                label = $"{c.Name}\n{c.EnvironmentTag}",
                shape = "box",
                color = new { background = "#eef3fb", border = "#4a76c4" }
            })
            .ToList();

        var edges = relationships
            .Where(r => r.Status != CdcRelationshipStatus.Rejected)
            .Select(r => new
            {
                from = r.SourceConnectionId,
                to = r.TargetConnectionId,
                label = EdgeLabel(r),
                color = new { color = EdgeColor(r) },
                title = EdgeTooltip(r)
            })
            .ToList();

        if (_module is not null)
            await _module.InvokeVoidAsync("render", "topology-canvas", nodes, edges);
    }

    private static string EdgeLabel(CdcRelationshipSummary r) =>
        r.LatestHealth?.LagBytes is { } lag ? $"{r.SlotName}\n{lag:N0}B lag" : r.SlotName;

    private static string EdgeColor(CdcRelationshipSummary r)
    {
        var health = r.LatestHealth;
        if (health is null) return "#adb5bd";

        return health.SubscriptionState switch
        {
            SubscriptionState.Enabled when health.SlotActive => "#28a745",
            SubscriptionState.Disabled => "#6c757d",
            SubscriptionState.Error => "#dc3545",
            _ => "#ffc107"
        };
    }

    private static string EdgeTooltip(CdcRelationshipSummary r)
    {
        var health = r.LatestHealth;
        var statusText = r.Status switch
        {
            CdcRelationshipStatus.Inferred => "Keşfedildi (onay bekliyor)",
            CdcRelationshipStatus.Confirmed => "Onaylandı",
            CdcRelationshipStatus.Manual => "Manuel tanımlandı",
            _ => r.Status.ToString()
        };

        var lines = new List<string>
        {
            $"Publication: {r.PublicationName}",
            $"Subscription: {r.SubscriptionName}",
            $"Slot: {r.SlotName}",
            $"Kayıt durumu: {statusText}"
        };

        if (health is not null)
        {
            lines.Add($"Subscription durumu: {health.SubscriptionState}");
            lines.Add($"Slot aktif: {health.SlotActive}");
            if (health.WalStatus is not null) lines.Add($"WAL durumu: {health.WalStatus}");
            if (health.LagBytes is not null) lines.Add($"Lag: {health.LagBytes:N0} byte");
            if (health.LastSyncAt is not null) lines.Add($"Son senkronizasyon: {health.LastSyncAt:u}");
        }

        return string.Join("\n", lines);
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_refreshLoopTask is not null)
        {
            try { await _refreshLoopTask; } catch { /* dispose sırasında beklenen */ }
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Devre zaten kapandıysa JS çağrısı atlanır.
            }
        }
    }
}
