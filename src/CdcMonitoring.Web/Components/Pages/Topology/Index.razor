@page "/topology"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject CdcRelationshipManagementService Management
@inject ConnectionRegistryService Registry
@inject IJSRuntime JS

<PageTitle>CDC Topoloji</PageTitle>

<h1>CDC Topoloji</h1>

<p>
    <span class="badge bg-success">Sağlıklı</span>
    <span class="badge bg-warning text-dark">Uyarı</span>
    <span class="badge bg-danger">Kritik</span>
    <span class="badge bg-secondary">Devre dışı / bilinmiyor</span>
    — her @_refreshIntervalSeconds sn'de bir otomatik güncellenir.
</p>

<p class="text-muted">
    Grafik hangi servisin kime bağlı olduğunu özetler; bir servise tıklayınca aşağıdaki listede
    o servisin tüm publication/subscription çiftleri ayrı ayrı görünür.
</p>

<div id="topology-canvas" style="width: 100%; height: 420px; border: 1px solid #dee2e6; border-radius: 4px;"></div>

@if (_relationshipCount == 0)
{
    <p class="text-muted mt-3"><em>Henüz görüntülenecek CDC ilişkisi yok.</em></p>
}
else
{
    <hr class="my-4" />
    <DomainPubSubList Views="_domainViews"
                      EnvironmentTags="_environmentTags"
                      SelectedConnectionId="_selectedConnectionId"
                      SelectedConnectionIdChanged="OnDomainSelected" />
}

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<Index>? _selfRef;
    private PeriodicTimer? _timer;
    private Task? _refreshLoopTask;
    private readonly int _refreshIntervalSeconds = 15;
    private int _relationshipCount;

    private IReadOnlyList<DomainPubSubView> _domainViews = [];
    private IReadOnlyDictionary<Guid, string> _environmentTags = new Dictionary<Guid, string>();
    private Guid? _selectedConnectionId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _selfRef = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/topology.js");
        await RefreshAsync();
        StateHasChanged();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));
        _refreshLoopTask = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync())
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException)
        {
            // Sayfa kapatıldığında timer dispose edilir; sessizce çık.
        }
    }

    private async Task RefreshAsync()
    {
        var connections = await Registry.ListAsync();
        var relationships = await Management.ListAsync();

        _relationshipCount = relationships.Count;
        _environmentTags = connections.ToDictionary(c => c.Id, c => c.EnvironmentTag);
        _domainViews = DomainPubSubBuilder.Build(relationships);

        if (_selectedConnectionId is null || _domainViews.All(v => v.ConnectionId != _selectedConnectionId))
            _selectedConnectionId = _domainViews.FirstOrDefault()?.ConnectionId;

        // Kaynak → publication (hub) → hedef üç katmanlı, akış yönlü topoloji.
        // Bir publication'ın birden fazla subscription'a bağlandığı durumlar (fan-out),
        // hub'dan çıkan ayrı kenarlar olarak görünür.
        var hierarchy = TopologyGraphBuilder.BuildHierarchy(relationships);

        var nodes = hierarchy.Nodes
            .Select(n => new
            {
                id = n.Id,
                label = n.Kind == "hub"
                    ? n.Label
                    : $"{n.Label}\n{(Guid.TryParse(n.Id, out var connectionId) ? _environmentTags.GetValueOrDefault(connectionId, "") : "")}",
                group = n.Kind
            })
            .ToList();

        var edges = new List<object>();

        edges.AddRange(hierarchy.HubEdges.Select(e => new
        {
            id = e.Id,
            from = (object)e.FromSourceId,
            to = (object)e.ToHubId,
            dashes = true,
            width = 1,
            color = new { color = "#adb5bd" }
        }));

        // Grafikte yalnızca ilişki sayısı yazar; slot/lag gibi ayrıntılar alttaki listede
        // okunaklı biçimde durduğu için kenar etiketleri kısa tutulur.
        edges.AddRange(hierarchy.LeafEdges.Select(e => new
        {
            id = e.Id,
            from = (object)e.FromHubId,
            to = (object)e.ToTargetId,
            dashes = false,
            width = e.Width,
            color = new { color = e.Color },
            title = e.Title,
            relationships = e.Relationships.Select(r => new
            {
                publication = r.PublicationName,
                subscription = r.SubscriptionName,
                slot = r.SlotName,
                status = r.StatusText,
                health = r.HealthText,
                lag = r.LagBytes,
                color = r.Color
            }).ToList()
        }));

        if (_module is not null)
            await _module.InvokeVoidAsync("render", "topology-canvas", nodes, edges, _selfRef);
    }

    [JSInvokable]
    public async Task OnNodeSelected(Guid connectionId)
    {
        _selectedConnectionId = connectionId;
        await InvokeAsync(StateHasChanged);
    }

    private void OnDomainSelected(Guid? connectionId) => _selectedConnectionId = connectionId;

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_refreshLoopTask is not null)
        {
            try { await _refreshLoopTask; } catch { /* dispose sırasında beklenen */ }
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Devre zaten kapandıysa JS çağrısı atlanır.
            }
        }

        _selfRef?.Dispose();
    }
}
