@page "/reconciliation"
@rendermode InteractiveServer
@inherits TimeZoneAwareComponentBase
@inject ReconciliationQueryService ReconciliationQuery

<PageTitle>Veri Tutarlılık Kontrolü</PageTitle>

<h1>Veri Tutarlılık Kontrolü</h1>

<p><em>Onaylanmış (Onaylandı/Manuel tanımlandı) CDC ilişkileri için haftalık kaynak-hedef satır sayısı/checksum karşılaştırması — salt-okuma.</em></p>

<div class="row mb-3 g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label mb-1">Durum</label>
        <select class="form-select form-select-sm" @bind="_statusFilter" @bind:after="ApplyFilterAsync">
            <option value="">Tümü</option>
            <option value="match">Eşleşti</option>
            <option value="mismatch">Tutarsız</option>
        </select>
    </div>
    <div class="col-auto ms-auto">
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_isRefreshing" @onclick="LoadAsync">
            @(_isRefreshing ? "Yenileniyor..." : "Yenile")
        </button>
    </div>
</div>

@if (_results is null)
{
    <p><em>Yükleniyor...</em></p>
}
else if (_results.Count == 0)
{
    <p><em>Filtreyle eşleşen kayıt bulunamadı.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Kaynak</th>
                <th>Hedef</th>
                <th>Slot</th>
                <th>Çalışma Zamanı</th>
                <th>Kaynak Satır</th>
                <th>Hedef Satır</th>
                <th>Durum</th>
                <th>Detay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _results)
            {
                <tr class="@(r.IsMatch ? "" : "table-danger")">
                    <td>@r.SourceConnectionName</td>
                    <td>@r.TargetConnectionName</td>
                    <td>@r.SlotName</td>
                    <td>@FormatLocal(r.RunAt)</td>
                    <td>@(r.SourceRowCount?.ToString("N0") ?? "-")</td>
                    <td>@(r.TargetRowCount?.ToString("N0") ?? "-")</td>
                    <td>
                        @if (r.IsMatch)
                        {
                            <span class="badge bg-success">Eşleşti</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Tutarsız</span>
                        }
                    </td>
                    <td><small>@r.Details</small></td>
                </tr>
            }
        </tbody>
    </table>

    <Pagination Page="_page" TotalPages="_totalPages" TotalCount="_totalCount" OnPageChange="ChangePageAsync" />
}

@code {
    private const int PageSize = 20;

    private List<ReconciliationResultSummary>? _results;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private bool _isRefreshing;

    private string _statusFilter = "";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ApplyFilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task ChangePageAsync(int newPage)
    {
        _page = newPage;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isRefreshing = true;
        try
        {
            bool? isMatch = _statusFilter switch
            {
                "match" => true,
                "mismatch" => false,
                _ => null
            };

            var filter = new ReconciliationResultFilter(isMatch);
            var result = await ReconciliationQuery.GetPagedAsync(filter, _page, PageSize);

            _results = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
        }
        finally
        {
            _isRefreshing = false;
        }
    }
}
