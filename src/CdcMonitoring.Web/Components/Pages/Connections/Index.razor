@page "/connections"
@rendermode InteractiveServer
@inject ConnectionRegistryService Registry
@inject NavigationManager Nav

<PageTitle>Bağlantılar</PageTitle>

<h1>Bağlantılar</h1>

<p><a class="btn btn-primary" href="connections/new">+ Yeni Bağlantı</a></p>

@if (_connections is null)
{
    <p><em>Yükleniyor...</em></p>
}
else if (_connections.Count == 0)
{
    <p><em>Henüz kayıtlı bağlantı yok.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Host:Port / DB</th>
                <th>Ortam</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _connections)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Host:@c.Port / @c.DatabaseName</td>
                    <td>@c.EnvironmentTag</td>
                    <td>@(c.IsActive ? "Aktif" : "Pasif")</td>
                    <td class="text-nowrap">
                        <a class="btn-icon" href="@($"connections/{c.Id}/edit")" title="Düzenle" aria-label="Düzenle">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><polygon points="10,1 14,5 5,14 1,15 2,11" /></svg>
                        </a>
                        @if (_confirmingDeleteId == c.Id)
                        {
                            <span> Silinsin mi?
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(c.Id)">Evet, sil</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => _confirmingDeleteId = null">Vazgeç</button>
                            </span>
                        }
                        else
                        {
                            <button class="btn-icon btn-icon-danger" @onclick="() => _confirmingDeleteId = c.Id" title="Sil" aria-label="Sil">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                    <rect x="3" y="5" width="10" height="9" rx="1" />
                                    <rect x="2" y="3" width="12" height="2" rx="1" />
                                    <rect x="6" y="1" width="4" height="2" rx="1" />
                                </svg>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@code {
    private List<ConnectionSummary>? _connections;
    private Guid? _confirmingDeleteId;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _connections = await Registry.ListAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        _errorMessage = null;
        try
        {
            await Registry.DeleteAsync(id);
            _confirmingDeleteId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
