@page "/Error"
@using System.Diagnostics

<PageTitle>Hata</PageTitle>

<h1 class="text-danger">Hata.</h1>
<h2 class="text-danger">İsteğiniz işlenirken bir hata oluştu.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>İstek Kimliği:</strong> <code>@RequestId</code>
    </p>
}

<h3>Development Modu</h3>
<p>
    <strong>Development</strong> ortamına geçmek, oluşan hata hakkında daha ayrıntılı bilgi gösterir.
</p>
<p>
    <strong>Development ortamı yayına alınmış uygulamalarda etkinleştirilmemelidir.</strong>
    Bu, exception'lardaki hassas bilgilerin son kullanıcılara gösterilmesine neden olabilir.
    Local debugging için <strong>ASPNETCORE_ENVIRONMENT</strong> ortam değişkenini <strong>Development</strong>
    olarak ayarlayıp uygulamayı yeniden başlatarak <strong>Development</strong> ortamını etkinleştirebilirsiniz.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
