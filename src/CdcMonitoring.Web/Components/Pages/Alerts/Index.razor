@page "/alerts"
@rendermode InteractiveServer
@inherits TimeZoneAwareComponentBase
@using CdcMonitoring.Domain.Enums
@inject AlertQueryService AlertQuery

<PageTitle>Alarmlar</PageTitle>

<h1>Alarmlar</h1>

<p><em>Sistem hiçbir koşulda otomatik düzeltici aksiyon almaz — burası yalnızca gözlem ve bildirim geçmişidir.</em></p>

<div class="row mb-3 g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label mb-1">Önem</label>
        <select class="form-select form-select-sm" @bind="_severityFilter" @bind:after="ApplyFilterAsync">
            <option value="">Tümü</option>
            <option value="@AlertSeverity.Critical">Kritik</option>
            <option value="@AlertSeverity.Warning">Uyarı</option>
            <option value="@AlertSeverity.Info">Bilgi</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label mb-1">Tür</label>
        <select class="form-select form-select-sm" @bind="_typeFilter" @bind:after="ApplyFilterAsync">
            <option value="">Tümü</option>
            <option value="@AlertType.SlotInactive">Slot İnaktif</option>
            <option value="@AlertType.WalCritical">WAL Kritik</option>
            <option value="@AlertType.SubscriptionError">Subscription Hatası</option>
            <option value="@AlertType.LagWarning">Lag Uyarısı</option>
            <option value="@AlertType.HealthCheckFailed">Health Check Başarısız</option>
            <option value="@AlertType.ReconciliationMismatch">Veri Tutarsızlığı</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label mb-1">Durum</label>
        <select class="form-select form-select-sm" @bind="_statusFilter" @bind:after="ApplyFilterAsync">
            <option value="">Tümü</option>
            <option value="active">Aktif</option>
            <option value="resolved">Çözüldü</option>
        </select>
    </div>
    <div class="col-auto ms-auto">
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_isRefreshing" @onclick="LoadAsync">
            @(_isRefreshing ? "Yenileniyor..." : "Yenile")
        </button>
    </div>
</div>

@if (_alerts is null)
{
    <p><em>Yükleniyor...</em></p>
}
else if (_alerts.Count == 0)
{
    <p><em>Filtreyle eşleşen alarm bulunamadı.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tür</th>
                <th>Önem</th>
                <th>Kaynak</th>
                <th>Mesaj</th>
                <th>Tetiklendi</th>
                <th>Bildirildi</th>
                <th>Çözüldü</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _alerts)
            {
                <tr class="@(a.ResolvedAt is null ? "table-warning" : "")">
                    <td>@TypeText(a.Type)</td>
                    <td>@SeverityBadge(a.Severity)</td>
                    <td>@(a.ConnectionName ?? a.RelationshipLabel ?? "-")</td>
                    <td>@a.Message</td>
                    <td>@FormatLocal(a.TriggeredAt)</td>
                    <td>@FormatLocal(a.NotifiedAt)</td>
                    <td>@FormatLocal(a.ResolvedAt, fallback: "Aktif")</td>
                </tr>
            }
        </tbody>
    </table>

    <Pagination Page="_page" TotalPages="_totalPages" TotalCount="_totalCount" OnPageChange="ChangePageAsync" />
}

@code {
    private const int PageSize = 20;

    private List<AlertEventSummary>? _alerts;
    private int _page = 1;
    private int _totalPages = 1;
    private int _totalCount;
    private bool _isRefreshing;

    private string _severityFilter = "";
    private string _typeFilter = "";
    private string _statusFilter = "";

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ApplyFilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task ChangePageAsync(int newPage)
    {
        _page = newPage;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isRefreshing = true;
        try
        {
            AlertSeverity? severity = Enum.TryParse<AlertSeverity>(_severityFilter, out var s) ? s : null;
            AlertType? type = Enum.TryParse<AlertType>(_typeFilter, out var t) ? t : null;
            bool? onlyActive = _statusFilter switch
            {
                "active" => true,
                "resolved" => false,
                _ => null
            };

            var filter = new AlertEventFilter(type, severity, onlyActive);
            var result = await AlertQuery.GetPagedAsync(filter, _page, PageSize);

            _alerts = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private static string TypeText(AlertType type) => type switch
    {
        AlertType.SlotInactive => "Slot İnaktif",
        AlertType.WalCritical => "WAL Kritik",
        AlertType.SubscriptionError => "Subscription Hatası",
        AlertType.LagWarning => "Lag Uyarısı",
        AlertType.HealthCheckFailed => "Health Check Başarısız",
        AlertType.ReconciliationMismatch => "Veri Tutarsızlığı",
        _ => type.ToString()
    };

    private static MarkupString SeverityBadge(AlertSeverity severity)
    {
        var (cls, text) = severity switch
        {
            AlertSeverity.Critical => ("bg-danger", "Kritik"),
            AlertSeverity.Warning => ("bg-warning text-dark", "Uyarı"),
            _ => ("bg-info text-dark", "Bilgi")
        };
        return new MarkupString($"<span class=\"badge {cls}\">{text}</span>");
    }
}
