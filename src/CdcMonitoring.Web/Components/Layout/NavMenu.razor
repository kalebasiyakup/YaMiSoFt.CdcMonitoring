@using System.Globalization
@using Microsoft.AspNetCore.Components

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CDC Monitoring</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Ana Sayfa
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="connections">
                <span class="bi bi-server-stack-nav-menu" aria-hidden="true"></span> Bağlantılar
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="relationships">
                <span class="bi bi-link-nav-menu" aria-hidden="true"></span> CDC İlişkileri
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="topology">
                <span class="bi bi-diagram-nav-menu" aria-hidden="true"></span> Topoloji
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="alerts">
                <span class="bi bi-bell-nav-menu" aria-hidden="true"></span> Alarmlar
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reconciliation">
                <span class="bi bi-shield-check-nav-menu" aria-hidden="true"></span> Veri Tutarlılık Kontrolü
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="schema-check">
                <span class="bi bi-schema-nav-menu" aria-hidden="true"></span> Şema Karşılaştırma
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="schema-catalog">
                <span class="bi bi-table-nav-menu" aria-hidden="true"></span> Şema Kataloğu
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-sliders-nav-menu" aria-hidden="true"></span> Ayarlar
            </NavLink>
        </div>
    </nav>

    <div class="nav-item px-3 culture-switcher">
        <div class="culture-switcher-label">Görünüm</div>
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn btn-outline-light @(_currentCulture == "tr-TR" ? "active" : "")" href="@CultureLink("tr-TR")">TR</a>
            <a class="btn btn-outline-light @(_currentCulture == "en-US" ? "active" : "")" href="@CultureLink("en-US")">EN</a>
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private readonly string _currentCulture = CultureInfo.CurrentCulture.Name;

    private string CultureLink(string culture) =>
        $"/culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri) is { Length: > 0 } path ? $"/{path}" : "/")}";
}
