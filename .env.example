# docker-compose.local.yml / docker-compose.yml bu dosyanın yanındaki ".env" dosyasını
# (git'e girmez) otomatik okur. Kullanmak için: cp .env.example .env  →  aşağıyı doldurun.
# Kafka bağlantı bilgilerinin HİÇBİRİ appsettings'e yazılmaz; hepsi buradan (ortam değişkeni) okunur.

# Kafka bootstrap sunucusu (host:port), ör. my-kafka.aivencloud.com:12345
KAFKA_BOOTSTRAP_SERVERS=
# Kafka SASL kullanıcı adı
KAFKA_USERNAME=
# Kafka SASL parolası
KAFKA_SASL_PASSWORD=
